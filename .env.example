# คัดลอกเป็น .env แล้วเติมค่า ·  .env อยู่ใน .gitignore ห้าม commit เด็ดขาด
#   cp .env.example .env

# ---------------------------------------------------------------- LLM
# dev = LM Studio ในเครื่อง (ไม่ต้องมีคีย์ ใส่อะไรก็ได้)
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen3.6-35b-a3b
LLM_API_KEY=not-needed-for-lmstudio

# prod = OpenRouter · สลับแค่ 4 บรรทัดบน ไม่ต้องแก้โค้ด
#   LLM_PROVIDER=openrouter
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=qwen/qwen3-vl-30b-a3b-instruct   # 🔴 ต้องมี a3b ไม่งั้น 404
#   LLM_API_KEY=sk-or-v1-xxxxxxxx

# 🔴 รัดให้พอดีที่ 'วัดได้' ไม่ใช่กัน overflow · ปล่อยยาวเกินคำตอบแย่ลงจริง มีหลักฐาน
# วัดกับ prompt จริง 2026-08-16: 200 ไม่พอ (finish=length content ว่าง) · 600 ตัดกลาง
# · 1200 จบเองที่ 621 tok ใน 17.7 วิ ตอบครบ  ->  ตั้ง 900 เผื่อไว้
# ตัวเลขนี้ผูกกับ model+prompt ตัวนี้ **เปลี่ยนโมเดลหรือแก้ prompt ต้องวัดใหม่ ห้ามลอก**
LLM_MAX_TOKENS=300
LLM_TIMEOUT_S=25

# ---------------------------------------------------------------- LangSmith
# ที่เดียวที่ log การเรียก LLM รอดข้ามรอบ deploy (SQLite หายทุก deploy บน App Platform)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_xxxxxxxx
LANGSMITH_PROJECT=animalcountllm

# 🔴 sampling ไม่ใช่ทางเลือก · 860 trace/วัน/กล้อง = 26,000/เดือน ทะลุแพ็กฟรี (~5,000) ตั้งแต่เดือนแรก
# เฟรมที่ผิดปกติเก็บ 100% เสมอ (conf ต่ำ / filter ตัด / degraded / finish_reason=length)
# ค่านี้คุมเฉพาะเฟรมที่ปกติดี ซึ่งเป็นของที่จะไม่กลับมาดูอยู่แล้ว
LANGSMITH_SAMPLE_RATE=0.05

# ---------------------------------------------------------------- storage
# sqlite ตอน POC · เปลี่ยนเป็น postgres ทีหลังโดยไม่ต้องแก้โค้ดส่วนอื่น
STORE_BACKEND=sqlite
STORE_DSN=./data/animals.db
RETENTION_DAYS=7

# เก็บภาพเฉพาะเฟรมที่น่าสนใจ (เจอสัตว์ / filter ตัดทิ้ง) ไม่ใช่ทุกใบ
# ทุกใบ = 3.5 GB/สัปดาห์/กล้อง · เฉพาะที่น่าสนใจ = 350 MB
SAVE_IMAGES=interesting
IMAGE_DIR=./data/frames

# ---------------------------------------------------------------- CV
# สัตว์ที่เล็กที่สุดที่กล้าบอกว่าตรวจเจอ (พิกเซล) · ต้องจูนใหม่เมื่อได้ภาพจากไซต์จริง
CV_MIN_AREA_PX=40

# ---------------------------------------------------------------- service
PORT=8080
API_KEY=

LLM_DISABLE_REASONING=true

# ================================================================
# งานที่สอง: smart people counting  (endpoint /people/*)
# ================================================================
# ปิดทั้งงานได้ด้วยตัวเดียว · ฝั่งช้างไม่กระทบเลย
PEOPLE_ENABLED=true

# 🔴 ฐานข้อมูลคนละไฟล์กับฝั่งช้าง ตามที่ Toy สั่ง 2026-09-11
# คนละตาราง คนละ connection คนละ retention · ลบของฝั่งหนึ่งไม่แตะอีกฝั่ง
# บน App Platform โฟลเดอร์แอปเขียนไม่ได้ โค้ดจะตกไป /tmp เองอัตโนมัติ
PEOPLE_STORE_DSN=./data/people.db
PEOPLE_RETENTION_DAYS=7

# 🔴 ค่าเริ่มต้นคือไม่เก็บภาพคน · none | degraded | all
# ในภาพคือหน้าคนที่เดินเข้าอาคาร ไม่ใช่สัตว์ในป่า เปิดเฉพาะตอนไล่บั๊กแล้วปิดกลับ
PEOPLE_SAVE_IMAGES=none
PEOPLE_IMAGE_DIR=./data/people-crops

# โมเดล: ไม่ตั้ง = ใช้ LLM_MODEL ตัวเดียวกับฝั่งช้าง (qwen3-vl-32b-instruct บน prod)
# PEOPLE_LLM_MODEL=qwen/qwen3-vl-32b-instruct

# คำตอบฝั่งนี้ยาวกว่าฝั่งช้างสิบเท่า (25 ฟิลด์ + คำบรรยายไทย) 300 ไม่พอแน่
# 700 -> 850 ตอนเพิ่ม uniform/emotion (2026-09-12) · ไฟล์นี้เคยค้างอยู่ที่ 700
# ทั้งที่โค้ดขยับไปแล้ว ซึ่งแปลว่าใครก๊อปไฟล์นี้ไปตั้งจริงจะได้ค่าที่ต่ำกว่าค่าเริ่มต้น
PEOPLE_LLM_MAX_TOKENS=850
# langchain retry 2 ครั้งเป็นค่าเริ่มต้น = ตอน provider ล่มจะรอ 3 เท่าของ timeout
PEOPLE_LLM_MAX_RETRIES=1

# ยิงขนานกี่คนพร้อมกัน · มากกว่านี้ไปชน rate limit ของ OpenRouter แทน
PEOPLE_WORKERS=4

# กรอบจาก tracker มักรัดพอดีตัวจนตัดรองเท้ากับผม ซึ่งเป็นของที่เราต้องรายงาน
PEOPLE_BBOX_MARGIN=0.08
# ขยาย crop เล็กๆ ก่อนส่ง · กัน provider ปฏิเสธภาพจิ๋ว (ผลต่อความแม่นยังไม่ได้วัด)
PEOPLE_MIN_CROP_PX=224

# ไม่ตั้ง = ใช้ API_KEY ตัวเดียวกับฝั่งช้าง · ตั้งแยกเมื่อต้องการถอนสิทธิ์คนละฝั่ง
# PEOPLE_API_KEY=

# ---- เส้น /people/v1/frames (ทั้งเฟรม ไม่มีใครถูกชี้)
# คำตอบยาวตามจำนวนคน ไม่คงที่เหมือนเส้น persons · วัดจริง 3 คน = 962 tok
# 🔴 2500 -> 3500 (2026-09-12) จำเป็น ไม่ใช่เผื่อเหนียว: uniform+emotion+group
# ทำให้เป็นราว 240 tok/คน x 12 = 2,880 ซึ่งทะลุ 2500 แล้วเสียทั้งเฟรม
PEOPLE_FRAME_MAX_TOKENS=3500
# เพดานคนต่อเฟรม · ล็อบบี้พักเที่ยงมีสามสิบคนได้ ตอบครบ = ยาวจนโดนตัดกลาง เสียทั้งเฟรม
PEOPLE_FRAME_MAX_PEOPLE=12

# ---- ซ่อนข้อมูลโมเดลจากปลายทาง (Toy สั่ง 2026-09-11)
# false = model ในคำตอบเป็น null และ /people/healthz ไม่บอกชื่อโมเดล/provider
# เปิดตอน dev เพื่อดู finish_reason กับจำนวน token · ของจริงยังเก็บครบใน DB เสมอ
PEOPLE_EXPOSE_MODEL=false


# ================================================================
# งานที่สาม: อ่านป้ายทะเบียนไทย LPR  (endpoint /lpr/*)
# ================================================================
# ปิดทั้งงานได้ด้วยตัวเดียว · อีกสองงานไม่กระทบเลย
LPR_ENABLED=true

# 🔴 ฐานข้อมูลคนละไฟล์กับอีกสองงาน · คนละตาราง คนละ connection คนละ retention
# 🔴 ตารางนี้เก็บ **ทะเบียนรถของคนจริง ซึ่งชี้ไปหาเจ้าของได้ผ่านฐานกรมขนส่ง**
# ควรตั้ง retention ให้สั้นกว่างานอื่น ไม่ใช่ยาวกว่า
LPR_STORE_DSN=./data/lpr.db
LPR_RETENTION_DAYS=7

# 🔴 ค่าเริ่มต้นคือไม่เก็บภาพ · none | degraded | all
# degraded = เก็บเฉพาะภาพที่อ่านป้ายไม่ออก ซึ่งคือชุดที่มีค่าตอนไล่บั๊กจริงๆ
LPR_SAVE_IMAGES=none
LPR_IMAGE_DIR=./data/lpr-crops

# โมเดล: ไม่ตั้ง = ใช้ LLM_MODEL ตัวเดียวกับงานอื่น
# ⚠️ **ยังไม่ได้วัดว่ามันอ่านอักษรไทยบนป้ายได้ดีแค่ไหน** งาน OCR ตัวอักษรเป็นคนละ
# ความสามารถกับงานบรรยายภาพ แยก env ไว้แล้วเพราะน่าจะต้องเปลี่ยนตัว
# LPR_LLM_MODEL=qwen/qwen3-vl-32b-instruct

# คำตอบสั้นกว่างานคนมาก (ไม่มีก้อน appearance) ราว 90 tok/คัน x 6 คัน + เผื่อ
LPR_LLM_MAX_TOKENS=900
LPR_LLM_MAX_RETRIES=1

# เพดานจำนวนคันต่อภาพ · ลานจอดมีสามสิบคันได้ ตอบครบ = ยาวจนโดนตัด เสียทั้งภาพ
LPR_MAX_VEHICLES=6

# กรอบป้ายจาก ALPR ปลายทางมักรัดพอดีขอบป้ายจนตัดตัวอักษรริมสุดทิ้ง
# ซึ่งเป็นตัวที่ทำให้ทะเบียนทั้งพวงผิด · เผื่อขอบไว้ 10%
LPR_BBOX_MARGIN=0.10
# ขยายครอปเล็กๆ ก่อนส่ง (ผลต่อความแม่นยังไม่ได้วัด เหมือนฝั่งงานคน)
LPR_MIN_CROP_PX=224

# ไม่ตั้ง = ใช้ API_KEY ตัวเดียวกับงานอื่น · ตั้งแยกเมื่อต้องการถอนสิทธิ์คนละฝั่ง
# LPR_API_KEY=

# false = model ในคำตอบเป็น null และ /lpr/healthz ไม่บอกชื่อโมเดล/provider
LPR_EXPOSE_MODEL=false
