{
  "info": {
    "name": "animalcountllm",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API นับสัตว์จากภาพกล้องความร้อน · ยิงตามลำดับใน folder 'ลำดับทดสอบ filter' จะเห็นพฤติกรรม fast attack / slow release ครบ"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://seal-app-qv5ao.ondigitalocean.app"
    },
    {
      "key": "api_key",
      "value": ""
    },
    {
      "key": "camera_id",
      "value": "cam-postman"
    },
    {
      "key": "request_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{api_key}}",
            "description": "ส่งเฉพาะตอนตั้ง API_KEY ไว้"
          }
        ],
        "url": {
          "raw": "{{base_url}}/healthz",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "healthz"
          ]
        },
        "description": "ไม่มี field store_path = ยังรันโค้ดเวอร์ชันเก่า"
      }
    },
